# ==========================================
# RESET MEN SALON — ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local for local development.
# Add ONLY these variables to Vercel → Settings → Environment Variables.
#
# All public business info (phone, address, email, WhatsApp) is
# hardcoded in src/config/site.ts — no env vars needed for those.
# ==========================================

# CMS PROVIDER — keep "mock" unless you set up Sanity/Contentful
CMS_PROVIDER=mock

# EMAIL — server-side only, never expose to browser
RESEND_API_KEY=

# RATE LIMITING — optional, Redis for distributed limits across serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CSP — set to "0" on preview/staging to keep CSP in report-only mode
# Leave unset (or "1") in production
CSP_ENFORCE=1
