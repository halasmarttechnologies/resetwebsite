# ==========================================
# RESET MEN SALON — ENVIRONMENT CONFIGURATION
# ==========================================

# SITE & CORE
NEXT_PUBLIC_SITE_URL=https://resetmensalon.ae
NEXT_PUBLIC_SITE_NAME="Reset Men Salon"
NEXT_PUBLIC_SITE_LOCALE=en_AE
NODE_ENV=development

# CONTACT & DIRECT CHANNELS
NEXT_PUBLIC_PHONE_NUMBER="+971 4 565 5688"
NEXT_PUBLIC_PHONE_CALL="tel:+97145655688"
NEXT_PUBLIC_WHATSAPP_NUMBER="+971 58 102 1540"
NEXT_PUBLIC_WHATSAPP_LINK="https://wa.me/971581021540"
NEXT_PUBLIC_SALON_EMAIL="info@resetmensalon.ae"
NEXT_PUBLIC_SALON_ADDRESS="Business Bay, Dubai, United Arab Emirates"
NEXT_PUBLIC_MAPS_LINK="https://maps.google.com/?q=Reset+Men+Salon+Business+Bay+Dubai"

# CMS CONFIGURATION (Headless / Decoupled Ready)
# Providers: "mock" | "sanity" | "contentful" | "strapi"
CMS_PROVIDER=mock
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_READ_TOKEN=

# BOOKING & CRM INTEGRATION
NEXT_PUBLIC_BOOKING_PROVIDER=whatsapp
NEXT_PUBLIC_BOOKING_URL=https://wa.me/971581021540?text=Hello%20Reset%20Men%20Salon,%20I%20would%20like%20to%20book%20an%20appointment.
BOOKING_WEBHOOK_SECRET=

# EMAIL NOTIFICATION (Resend / Nodemailer)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=info@resetmensalon.ae

# DATABASE (Supabase / Postgres for caching / dynamic submissions)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ANALYTICS & MARKETING
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# MONITORING & ERROR TRACKING
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# RATE LIMITING & SECURITY
# UPSTASH_* — recommended for production. When both are set, the rate
#            limiter uses Redis so limits are shared across every
#            serverless instance. When unset it falls back to a
#            per-instance in-memory store (fine for a single-node
#            deployment; NOT suitable for globally distributed traffic).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# CSP_ENFORCE — set to "0" on a preview deployment to keep the CSP in
# report-only mode while auditing. Leave unset (or "1") in production
# so the browser actively blocks violations.
CSP_ENFORCE=1

# ==========================================
# SECRET vs PUBLIC — DO NOT MIX
# ==========================================
# The `NEXT_PUBLIC_` prefix inlines a value into the client bundle. Any
# variable prefixed this way MUST be safe for the browser to see. The
# following variables are SERVER-ONLY and must never be renamed with a
# `NEXT_PUBLIC_` prefix:
#
#   RESEND_API_KEY
#   SANITY_READ_TOKEN
#   SUPABASE_SERVICE_ROLE_KEY
#   DATABASE_URL
#   BOOKING_WEBHOOK_SECRET
#   SENTRY_AUTH_TOKEN
#   UPSTASH_REDIS_REST_TOKEN
#   CONTACT_NOTIFICATION_EMAIL
#
# If you need one of these on the client, wrap it behind an API route.
